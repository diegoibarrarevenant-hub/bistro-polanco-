# Copy this file to .env and fill in the values

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bistro_polanco?schema=public"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payment gateway (Conekta — recommended for MXN) ──────────────────────────
CONEKTA_PRIVATE_KEY=""
NEXT_PUBLIC_CONEKTA_PUBLIC_KEY=""

# ── Storage (Cloudinary or S3 for images / PDF proposals) ────────────────────
CLOUDINARY_URL=""

# ── Email (Resend for transactional emails) ───────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="reservaciones@bistropolanco.mx"
